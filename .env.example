# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Anthropic (brief generation; app falls back to a template brief if unset) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_TIMEOUT_S=20
ANTHROPIC_MAX_RETRIES=2

# --- Paths (relative to repo root) ---
DATA_DIR=Data
ARTIFACTS_DIR=artifacts
DECISIONS_DB=artifacts/decisions.db

# --- Decision log: dynamodb (AWS) or sqlite (local file). dynamodb falls back to sqlite on errors. ---
DB_BACKEND=dynamodb
DDB_TABLE_DECISIONS=sabwat-decisions
DDB_TABLE_BRIEFS=sabwat-briefs

# --- AWS. Local only: short-lived SSO session credentials, refresh when they expire.
# On EC2 leave these blank; the sabwat-ec2-profile instance role supplies credentials. ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=ap-southeast-1

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
