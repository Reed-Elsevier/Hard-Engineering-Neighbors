# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- AI writer for the case brief (app falls back to a template brief if the key is unset) ---
# LLM_PROVIDER: gemini (Google AI Studio key) or anthropic (Claude)
LLM_PROVIDER=gemini
LLM_TIMEOUT_S=12
LLM_MAX_RETRIES=2

# Gemini: create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Pinned: the -latest aliases can change model mid-event. flash-lite was the only free-tier
# model reliably available on 2026-10-09 (Flash models returned 503 overloaded).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Claude (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Opus 5.5 has no temperature and always thinks; effort is the speed/depth control.
ANTHROPIC_EFFORT=low

# --- Paths (relative to repo root) ---
DATA_DIR=Data
ARTIFACTS_DIR=artifacts
DECISIONS_DB=artifacts/decisions.db

# --- Decision log: dynamodb (AWS) or sqlite (local file). dynamodb falls back to sqlite on errors. ---
DB_BACKEND=dynamodb
DDB_TABLE_DECISIONS=sabwat-decisions
DDB_TABLE_BRIEFS=sabwat-briefs

# --- AWS. Local only: short-lived SSO session credentials, refresh when they expire.
# On EC2 leave these blank; the sabwat-ec2-profile instance role supplies credentials. ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=ap-southeast-1

# --- API server ---
API_HOST=0.0.0.0
API_PORT=8000
