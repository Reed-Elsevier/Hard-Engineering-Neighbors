*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# --- Node (web/ has its own .gitignore too) ---
node_modules/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json

# Upload-ready copy of the parquet files the deploy platform needs (never committed)
deploy-data/
