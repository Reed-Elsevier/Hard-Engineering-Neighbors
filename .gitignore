# --- Secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Company data: never commit (synthetic, but event-restricted) ---
Data/
data/
_judges_only/

# --- Generated ---
artifacts/
*.db
*.sqlite
*.pkl
logs/
*.log

# --- Python ---
.venv/
venv/
